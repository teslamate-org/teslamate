{
  "db_name": "PostgreSQL",
  "query": "-- The Repo.update of TeslaMate.Log.close_drive/2. Ecto writes the\n-- aggregates as they are, NULLs included, and a geofence only when one was\n-- found, so a missing one keeps the column's value. The address columns are\n-- not written: the port runs without address lookup.\n-- duration_min, ascent and descent come as integer and bigint and are\n-- stored as smallint by Postgres, which fails on overflow as Postgrex does.\nUPDATE drives SET\n  start_date = $2,\n  end_date = $3,\n  start_position_id = $4,\n  end_position_id = $5,\n  outside_temp_avg = $6,\n  inside_temp_avg = $7,\n  speed_max = $8,\n  power_max = $9,\n  power_min = $10,\n  start_ideal_range_km = $11,\n  end_ideal_range_km = $12,\n  start_rated_range_km = $13,\n  end_rated_range_km = $14,\n  start_km = $15,\n  end_km = $16,\n  distance = $17,\n  duration_min = $18::integer,\n  ascent = $19::bigint,\n  descent = $20::bigint,\n  start_geofence_id = COALESCE($21, start_geofence_id),\n  end_geofence_id = COALESCE($22, end_geofence_id)\nWHERE id = $1\nRETURNING\n  id,\n  car_id,\n  start_date,\n  end_date,\n  start_position_id,\n  end_position_id,\n  start_address_id,\n  end_address_id,\n  start_geofence_id,\n  end_geofence_id,\n  outside_temp_avg,\n  inside_temp_avg,\n  speed_max,\n  power_max,\n  power_min,\n  start_ideal_range_km,\n  end_ideal_range_km,\n  start_rated_range_km,\n  end_rated_range_km,\n  start_km,\n  end_km,\n  distance,\n  duration_min,\n  ascent,\n  descent\n",
