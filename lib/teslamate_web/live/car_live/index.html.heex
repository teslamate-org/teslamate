<%= for summary <- @summaries do %>
  {live_render(@socket, TeslaMateWeb.CarLive.Summary,
    id: "car_#{summary.car.id}",
    session: %{"summary" => summary, "settings" => @settings}
  )}
<% end %>

<%= if @summaries == [] do %>
  <div class="columns is-tablet is-centered">
    <div class="column is-half">
      <div id="no-vehicles" class="box has-text-centered">
        <%= if @known_cars? do %>
          <p class="title is-5">{gettext("No vehicles enabled")}</p>
          <p class="mb-4">
            {gettext("Data collection is disabled for all vehicles.")}
            {link(gettext("Settings"),
              to: Routes.live_path(@socket, TeslaMateWeb.SettingsLive.Index)
            )}
          </p>
        <% else %>
          <p class="title is-5">{gettext("No vehicles found")}</p>
        <% end %>

        <%= if @discovery != :ok do %>
          <p class="mb-4">{discovery_hint(@discovery)}</p>
          <button
            type="button"
            class={["button is-info is-rounded", if(@reloading?, do: "is-loading")]}
            disabled={@reloading?}
            phx-click="reload_vehicles"
          >
            <span class="icon"><span class="mdi mdi-reload"></span></span>
            <span>{gettext("Reload vehicles")}</span>
          </button>
          <p :if={@reload_error} class="help is-danger">{@reload_error}</p>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
