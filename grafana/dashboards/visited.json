        "uid": "TeslaMate"
      },
      "description": "Shared visit data for this car and the selected time range. The summary, Countries and Cities panels reuse this query.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#ad46ff",
            "mode": "fixed"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
