        "x": 14,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.2.2",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH visits AS (\n  SELECT v.address_id, v.ts\n  FROM drives d\n  CROSS JOIN LATERAL (VALUES (d.start_address_id, d.start_date),\n                             (d.end_address_id,   d.end_date)) AS v(address_id, ts)\n  WHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL\n  UNION ALL\n  SELECT cp.address_id, cp.start_date\n  FROM charging_processes cp\n  WHERE cp.car_id = $car_id AND $__timeFilter(cp.start_date)\n), places AS (\n  SELECT a.country AS country_name,\n         COALESCE(a.city, a.neighbourhood) AS \"City\",\n         COALESCE(NULLIF(a.state_district, ''), NULLIF(a.state, ''), '') AS region_name,\n         COALESCE(NULLIF(lower(a.raw #>> '{address,country_code}'), ''), 'name:' || lower(a.country)) AS country_code,\n         a.latitude,\n         a.longitude,\n         v.ts AS visit,\n         (timezone('UTC', v.ts) AT TIME ZONE '$__timezone')::date AS local_day\n  FROM visits v\n  JOIN addresses a ON a.id = v.address_id\n  WHERE a.country IS NOT NULL AND COALESCE(a.city, a.neighbourhood) IS NOT NULL\n), normalized_places AS (\n  SELECT country_code,\n         min(country_name) OVER (PARTITION BY country_code) AS \"Country\",\n         \"City\",\n         region_name AS \"Region\",\n         latitude,\n         longitude,\n         visit,\n         local_day\n  FROM places\n), stats AS (\n  SELECT count(DISTINCT country_code) AS \"Countries\",\n         count(DISTINCT (country_code, \"City\", \"Region\")) AS \"Cities\",\n         min(visit) AS \"From\",\n         max(visit) AS \"To\",\n         count(DISTINCT local_day) AS \"Days\"\n  FROM normalized_places\n)\nSELECT normalized_places.*,\n       jsonb_build_array(country_code, \"City\", \"Region\")::text AS city_key,\n       stats.\"Countries\",\n       stats.\"Cities\",\n       stats.\"From\",\n       stats.\"To\",\n       stats.\"Days\"\nFROM normalized_places\nCROSS JOIN stats",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Countries",
                "Cities"
              ]
            }
          }
        }
      ],
      "type": "stat"
