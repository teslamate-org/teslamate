      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH addr AS (\n  SELECT id, name, road, house_number, display_name\n  FROM addresses\n  WHERE COALESCE(NULLIF(lower(raw #>> '{address,country_code}'), ''), 'name:' || lower(country)) = ${country_code:sqlstring}\n    AND COALESCE(city, neighbourhood) = ${city:sqlstring}\n    AND COALESCE(NULLIF(state_district, ''), NULLIF(state, ''), '') = ${region:sqlstring}\n), visits AS (\n  SELECT 'drive' AS kind, d.id AS ref_id, d.start_date AS ts, d.start_address_id AS address_id\n  FROM drives d\n  WHERE d.car_id = $car_id AND d.car_id = NULLIF('$selected_car_id', '')::smallint AND d.start_address_id IN (SELECT id FROM addr)\n    AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL\n  UNION ALL\n  SELECT 'drive', d.id, d.end_date, d.end_address_id\n  FROM drives d\n  WHERE d.car_id = $car_id AND d.car_id = NULLIF('$selected_car_id', '')::smallint AND d.end_address_id IN (SELECT id FROM addr)\n    AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL\n  UNION ALL\n  SELECT 'charge', cp.id, cp.start_date, cp.address_id\n  FROM charging_processes cp\n  WHERE cp.car_id = $car_id AND cp.car_id = NULLIF('$selected_car_id', '')::smallint AND cp.address_id IN (SELECT id FROM addr)\n    AND $__timeFilter(cp.start_date)\n)\nSELECT to_char((timezone('UTC', min(v.ts)) AT TIME ZONE '$__timezone'), 'YYYY-MM-DD')               AS \"Date\",\n       min(v.ts)                                                 AS \"First seen\",\n       max(v.ts)                                                 AS \"Last seen\",\n       count(DISTINCT v.ref_id) FILTER (WHERE v.kind = 'drive')  AS \"Drives\",\n       count(DISTINCT v.ref_id) FILTER (WHERE v.kind = 'charge') AS \"Charges\",\n       string_agg(DISTINCT COALESCE(a.name, nullif(concat_ws(' ', a.road, a.house_number), ''),\n                                    split_part(a.display_name, ',', 1)), ' · ') AS \"Places\",\n       (extract(epoch FROM date_trunc('day', timezone('UTC', min(v.ts)), '$__timezone')) * 1000)::bigint                       AS day_from,\n       (extract(epoch FROM (((timezone('UTC', min(v.ts)) AT TIME ZONE '$__timezone')::date + 1)::timestamp AT TIME ZONE '$__timezone')) * 1000)::bigint - 1 AS day_to\nFROM visits v\nJOIN addr a ON a.id = v.address_id\nGROUP BY (timezone('UTC', v.ts) AT TIME ZONE '$__timezone')::date\nORDER BY min(v.ts) DESC",
          "refId": "A"
        }
      ],
      "title": "Days in selected city",
      "type": "table"
    }
