          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH speed_buckets AS (\n    SELECT\n        car_id,\n        CASE\n            WHEN '$length_unit' = 'km' THEN\n                ROUND((convert_km(distance::numeric, '$length_unit') / NULLIF(duration_min::numeric, 0) * 60)::numeric / 20, 0) * 20\n            ELSE\n                ROUND((convert_km(distance::numeric, '$length_unit') / NULLIF(duration_min::numeric, 0) * 60)::numeric / 30, 0) * 30\n        END AS speed_bucket,\n        start_${preferred_range}_range_km - end_${preferred_range}_range_km AS range_loss,\n        distance,\n        duration_min\n    FROM drives\n    WHERE distance IS NOT NULL\n        AND car_id = $car_id\n        AND convert_km(distance::numeric, '$length_unit') >= $min_distance\n        AND $__timeFilter(start_date)\n        AND start_${preferred_range}_range_km - end_${preferred_range}_range_km > 0.1\n        AND duration_min > 0\n)\nSELECT\n    sb.speed_bucket AS speed_$length_unit,\n    sum(sb.range_loss) / NULLIF(convert_km(sum(sb.distance)::numeric, '$length_unit'), 0) * 100 AS consumption_$length_unit,\n    convert_km(sum(sb.distance)::numeric, '$length_unit') AS total_distance_$length_unit,\n    count(*) AS drives\nFROM speed_buckets sb\nWHERE sb.speed_bucket IS NOT NULL\nGROUP BY sb.speed_bucket\nORDER BY sb.speed_bucket",
          "refId": "A",
          "sql": {
            "columns": [
