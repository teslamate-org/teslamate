      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 6,
      "interval": "7d",
      "maxDataPoints": 400,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min",
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH d AS (\n  SELECT id, start_date, start_date - lag(end_date) OVER (ORDER BY start_date) AS parked\n  FROM drives\n  WHERE car_id = $car_id\n), cold AS (\n  SELECT\n    d.start_date AS t,\n    avg(p.tpms_pressure_fl) AS fl,\n    avg(p.tpms_pressure_fr) AS fr,\n    avg(p.tpms_pressure_rl) AS rl,\n    avg(p.tpms_pressure_rr) AS rr,\n    avg(p.outside_temp) AS temp\n  FROM d\n  JOIN positions p ON p.drive_id = d.id\n    AND p.date BETWEEN d.start_date + interval '1 minute' AND d.start_date + interval '5 minutes'\n  WHERE d.parked > interval '3 hours'\n    AND p.car_id = $car_id\n    AND p.ideal_battery_range_km IS NOT NULL\n    AND p.tpms_pressure_fl IS NOT NULL\n    AND $__timeFilter(d.start_date)\n    AND $__timeFilter(p.date)\n  GROUP BY d.id, d.start_date\n)\nSELECT\n  $__timeGroupAlias(t, $__interval),\n  convert_tire_pressure(avg((fl + 1.01325) * 293.15 / (temp + 273.15) - 1.01325), '$pressure_unit') AS \"Front Left [$pressure_unit]\",\n  convert_tire_pressure(avg((fr + 1.01325) * 293.15 / (temp + 273.15) - 1.01325), '$pressure_unit') AS \"Front Right [$pressure_unit]\",\n  convert_tire_pressure(avg((rl + 1.01325) * 293.15 / (temp + 273.15) - 1.01325), '$pressure_unit') AS \"Rear Left [$pressure_unit]\",\n  convert_tire_pressure(avg((rr + 1.01325) * 293.15 / (temp + 273.15) - 1.01325), '$pressure_unit') AS \"Rear Right [$pressure_unit]\"\nFROM cold\nWHERE temp IS NOT NULL\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Cold Pressure at 20 °C",
      "type": "timeseries"
    },
