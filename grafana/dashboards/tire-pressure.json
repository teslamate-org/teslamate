              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/\\[°[CF]\\]$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "degree"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^Front Left/"
            },
            "properties": [
              {
                "id": "color",
