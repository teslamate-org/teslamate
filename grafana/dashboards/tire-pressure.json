          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text"
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/\\[psi\\]$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "pressurepsi"
              }
            ]
          },
          {
            "matcher": {
