          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(date, $__interval),\n  convert_tire_pressure(avg(tpms_pressure_fl), '$pressure_unit') AS \"Front Left [$pressure_unit]\",\n  convert_tire_pressure(avg(tpms_pressure_fr), '$pressure_unit') AS \"Front Right [$pressure_unit]\",\n  convert_tire_pressure(avg(tpms_pressure_rl), '$pressure_unit') AS \"Rear Left [$pressure_unit]\",\n  convert_tire_pressure(avg(tpms_pressure_rr), '$pressure_unit') AS \"Rear Right [$pressure_unit]\"\nFROM positions\nWHERE car_id = $car_id\n  AND ideal_battery_range_km IS NOT NULL\n  AND tpms_pressure_fl IS NOT NULL\n  AND $__timeFilter(date)\nGROUP BY 1\nORDER BY 1",
