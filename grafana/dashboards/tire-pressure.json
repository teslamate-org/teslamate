          "rawSql": "SELECT\n  $__timeGroupAlias(date, $__interval),\n  convert_tire_pressure(avg(GREATEST(tpms_pressure_fl, tpms_pressure_fr, tpms_pressure_rl, tpms_pressure_rr) - LEAST(tpms_pressure_fl, tpms_pressure_fr, tpms_pressure_rl, tpms_pressure_rr)), '$pressure_unit') AS \"Max - Min [$pressure_unit]\",\n  convert_tire_pressure(avg(tpms_pressure_fl - tpms_pressure_fr), '$pressure_unit') AS \"Front L - R [$pressure_unit]\",\n  convert_tire_pressure(avg(tpms_pressure_rl - tpms_pressure_rr), '$pressure_unit') AS \"Rear L - R [$pressure_unit]\"\nFROM positions\nWHERE car_id = $car_id\n  AND ideal_battery_range_km IS NOT NULL\n  AND tpms_pressure_fl IS NOT NULL\n  AND $__timeFilter(date)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Pressure Imbalance",
