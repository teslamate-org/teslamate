        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "description": "Pressure at the start of drives after 3+ hours parked, normalized to 20 °C (68 °F) outside temperature. Removes seasonal and driving-heat swings.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
