          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(date, $__interval),\n  convert_celsius(avg(outside_temp), '$temp_unit') AS \"Outside (charging) [°$temp_unit]\"\nFROM charges c\nJOIN charging_processes cp ON cp.id = c.charging_process_id\nWHERE cp.car_id = $car_id AND $__timeFilter(date)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
