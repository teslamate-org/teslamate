    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "TeslaMate" },
      "description": "Daily outside temperature envelope, computed on time-debiased inputs: readings are first averaged into fixed 15-minute bins, then aggregated per day. Wick = min/max, body = 15th–85th percentile. Days without samples have no candle.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "scaleDistribution": { "type": "linear" }
          },
          "decimals": 1,
          "mappings": [],
          "unit": "degree"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 27 },
      "id": 8,
      "options": {
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "colors": { "down": "blue", "flat": "gray", "up": "red" },
        "fields": { "close": "close", "high": "high", "low": "low", "open": "open" },
        "includeAllFields": false,
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": false },
        "mode": "candles"
      },
      "pluginVersion": "13.0.1+security-01",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "TeslaMate" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH binned AS (\n  SELECT\n    to_timestamp(floor(extract(epoch FROM date) / 900) * 900) AS bin,\n    avg(outside_temp) AS outside_temp\n  FROM positions\n  WHERE car_id = $car_id AND outside_temp IS NOT NULL AND $__timeFilter(date)\n  GROUP BY 1\n)\nSELECT\n  date_trunc('day', bin) AS time,\n  convert_celsius(max(outside_temp), '$temp_unit') AS high,\n  convert_celsius(min(outside_temp), '$temp_unit') AS low,\n  convert_celsius(percentile_cont(0.15) WITHIN GROUP (ORDER BY outside_temp::double precision)::numeric, '$temp_unit') AS open,\n  convert_celsius(percentile_cont(0.85) WITHIN GROUP (ORDER BY outside_temp::double precision)::numeric, '$temp_unit') AS close\nFROM binned\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Daily Outside Temperature (min/max, p15–p85)",
      "type": "candlestick"
    }
